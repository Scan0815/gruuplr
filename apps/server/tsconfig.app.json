{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceRoot": "/",
    "sourceMap": true,
    "module": "commonjs",
    "inlineSources": true,
    "types": ["node"],
    "declaration": true,
    "tsBuildInfoFile": "out-tsc/server/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/dtos"
    }
  ]
}
